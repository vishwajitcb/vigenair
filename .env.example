# ViGenAiR Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Google Cloud Platform Configuration
# =============================================================================
# GCS bucket for storing videos and processed data
GCS_BUCKET=your-vigenair-bucket

# GCP project ID (for Vertex AI Gemini API calls)
GCS_PROJECT_ID=your-gcp-project-id

# GCP region for Vertex AI
GCS_LOCATION=us-central1

# Path to service account JSON key file
# The service account needs: Storage Admin + Vertex AI User roles
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================
# Gemini model to use for text generation
CONFIG_TEXT_MODEL=gemini-2.0-flash

# Gemini model to use for vision/video analysis
CONFIG_VISION_MODEL=gemini-2.0-flash

# Gemini model for audio transcription
CONFIG_TRANSCRIPTION_MODEL_GEMINI=gemini-2.0-flash

# =============================================================================
# OPTIONAL: Processing Configuration
# =============================================================================
# Maximum video chunk size in bytes (default: 500MB)
CONFIG_MAX_VIDEO_CHUNK_SIZE=500000000

# Maximum audio chunk size in seconds (default: 300s = 5 minutes)
CONFIG_MAX_AUDIO_CHUNK_SIZE=300

# Maximum concurrent workers for parallel chunk/segment processing (default: 5)
CONFIG_MAX_CONCURRENCY=5

# Maximum concurrent browser-to-GCS parallel upload workers (default: 6)
CONFIG_MAX_UPLOAD_CONCURRENCY=6

# Default fade-out duration in seconds
CONFIG_DEFAULT_FADE_OUT_DURATION=1

# Maximum duration in seconds for individual segments offered to the variant generator (default: 6)
CONFIG_MAX_VARIANT_SEGMENT_DURATION=6

# Backend version identifier
CONFIG_BACKEND_VERSION=v1

# =============================================================================
# OPTIONAL: CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins (use * for development)
CORS_ORIGINS=*

# =============================================================================
# OPTIONAL: Frontend Configuration
# =============================================================================
# Backend API URL (used by frontend container)
API_BASE_URL=http://backend:8000
